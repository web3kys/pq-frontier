---
// Animated SVG explainers — one per section, each visualising the field's
// core idea. Pure SVG + CSS animations (no JS), accent-coloured.
interface Props { kind: string }
const { kind } = Astro.props;
---

<div class={`art art-${kind}`} aria-hidden="true">
  {kind === 'lattice' && (
    <svg viewBox="0 0 320 200">
      {[0, 1, 2, 3, 4].map((i) => (
        <line x1={40 + i * 60} y1="30" x2={40 + i * 60} y2="170" class="dim" />
      ))}
      {[0, 1, 2].map((j) => (
        <line x1="40" y1={30 + j * 70} x2="280" y2={30 + j * 70} class="dim" />
      ))}
      {[0, 1, 2, 3, 4].map((i) =>
        [0, 1, 2].map((j) => <circle cx={40 + i * 60} cy={30 + j * 70} r="4" class="node" />),
      )}
      <circle cx="40" cy="100" r="10" class="keynode" />
      <circle cx="280" cy="100" r="10" class="keynode" />
      <g class="traveller" style="--travel: 216px">
        <circle cx="52" cy="100" r="6" class="capsule" />
      </g>
    </svg>
  )}

  {kind === 'orbit' && (
    <svg viewBox="0 0 320 200">
      <circle cx="160" cy="92" r="13" class="keynode" />
      <g class="spin-a"><ellipse cx="160" cy="92" rx="86" ry="30" class="ring" /></g>
      <g class="spin-b"><ellipse cx="160" cy="92" rx="86" ry="30" class="ring" transform="rotate(60 160 92)" /></g>
      <g class="spin-c"><ellipse cx="160" cy="92" rx="86" ry="30" class="ring" transform="rotate(120 160 92)" /></g>
      <circle cx="246" cy="92" r="5" class="capsule spin-a-rev" />
      <path d="M20 172 Q 55 148, 90 172 T 160 172 T 230 172 T 300 172" class="wave" />
    </svg>
  )}

  {kind === 'shield' && (
    <svg viewBox="0 0 320 200">
      <defs>
        <clipPath id="shield-clip">
          <path d="M160 18 L246 48 V104 C246 146 214 172 160 186 C106 172 74 146 74 104 V48 Z" />
        </clipPath>
      </defs>
      <path d="M160 18 L246 48 V104 C246 146 214 172 160 186 C106 172 74 146 74 104 V48 Z" class="outline" />
      <g clip-path="url(#shield-clip)">
        <rect x="70" y="30" width="180" height="10" class="scan" />
        {[0, 1, 2, 3].map((i) => (
          <line x1={104 + i * 38} y1="26" x2={104 + i * 38} y2="182" class="dim" />
        ))}
      </g>
      <rect x="136" y="94" width="48" height="38" rx="6" class="lockbody" />
      <path d="M146 94 V80 a14 14 0 0 1 28 0 V94" class="lockarc" />
      <circle cx="160" cy="110" r="5" class="capsule" />
    </svg>
  )}

  {kind === 'roadmap' && (
    <svg viewBox="0 0 320 200">
      <path d="M28 128 C 90 128, 110 66, 168 66 S 262 104, 296 84" class="route" />
      {[
        { x: 28, y: 128, d: '0s' },
        { x: 92, y: 112, d: '0.7s' },
        { x: 168, y: 66, d: '1.4s' },
        { x: 232, y: 84, d: '2.1s' },
        { x: 296, y: 84, d: '2.8s' },
      ].map((n) => (
        <g>
          <circle cx={n.x} cy={n.y} r="11" class="step-halo" style={`animation-delay: ${n.d}`} />
          <circle cx={n.x} cy={n.y} r="5.5" class="step-dot" style={`animation-delay: ${n.d}`} />
        </g>
      ))}
      <g class="traveller-x" style="--travel: 248px">
        <circle cx="34" cy="150" r="5" class="capsule" />
      </g>
      <line x1="28" y1="150" x2="292" y2="150" class="dim" />
    </svg>
  )}

  {kind === 'constellation' && (
    <svg viewBox="0 0 320 200">
      <polyline points="36,150 84,96 128,122 168,58 214,88 252,40 292,74" class="starline" />
      {[
        { x: 36, y: 150, d: '0s' },
        { x: 84, y: 96, d: '0.5s' },
        { x: 128, y: 122, d: '1s' },
        { x: 168, y: 58, d: '1.5s' },
        { x: 214, y: 88, d: '2s' },
        { x: 252, y: 40, d: '2.5s' },
        { x: 292, y: 74, d: '3s' },
      ].map((n) => (
        <circle cx={n.x} cy={n.y} r="5" class="twinkle" style={`animation-delay: ${n.d}`} />
      ))}
      <circle cx="60" cy="52" r="2.4" class="twinkle" style="animation-delay: 0.8s" />
      <circle cx="238" cy="150" r="2.4" class="twinkle" style="animation-delay: 1.9s" />
      <circle cx="150" cy="168" r="2.4" class="twinkle" style="animation-delay: 2.7s" />
    </svg>
  )}

  {kind === 'terminal' && (
    <svg viewBox="0 0 320 200">
      <rect x="36" y="30" width="248" height="140" rx="10" class="win" />
      <circle cx="56" cy="48" r="4" class="dot dim" />
      <circle cx="72" cy="48" r="4" class="dot dim" />
      <circle cx="88" cy="48" r="4" class="dot dim" />
      <g class="code-lines">
        <rect x="54" y="72" width="150" height="9" rx="4.5" class="code l1" />
        <rect x="54" y="96" width="196" height="9" rx="4.5" class="code l2" />
        <rect x="54" y="120" width="118" height="9" rx="4.5" class="code l3" />
      </g>
      <rect x="54" y="144" width="10" height="13" class="cursor" />
    </svg>
  )}

  {kind === 'index' && (
    <svg viewBox="0 0 320 200">
      <circle cx="160" cy="100" r="30" class="ring" />
      <circle cx="160" cy="100" r="56" class="ring dim-ring" />
      <circle cx="160" cy="100" r="80" class="ring dim-ring" />
      <g class="spin-a"><circle cx="216" cy="100" r="5" class="capsule" /></g>
      <g class="spin-c"><circle cx="80" cy="100" r="4" class="capsule" /></g>
      <circle cx="160" cy="100" r="7" class="keynode" />
      {[0, 1, 2].map((i) => (
        <line x1={52 + i * 8} y1={168 - i * 0} x2={268 - i * 8} y2={168} class="dim" />
      ))}
    </svg>
  )}

  {kind === 'atom' && (
    <svg viewBox="0 0 320 200">
      <circle cx="160" cy="100" r="11" class="keynode" />
      <g class="spin-a"><ellipse cx="160" cy="100" rx="104" ry="38" class="ring" /></g>
      <g class="spin-b"><ellipse cx="160" cy="100" rx="104" ry="38" class="ring" transform="rotate(60 160 100)" /></g>
      <g class="spin-c"><ellipse cx="160" cy="100" rx="104" ry="38" class="ring" transform="rotate(120 160 100)" /></g>
    </svg>
  )}
</div>
