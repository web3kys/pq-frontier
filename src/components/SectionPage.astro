---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from './ArticleCard.astro';
import ExplainerArt from './ExplainerArt.astro';
import { EXPLAINERS } from '../lib/explainers';
import { sectionBySlug, ui, type Lang } from '../lib/i18n';

interface Props { lang: Lang; section: string }
const { lang, section } = Astro.props;
const t = ui[lang];
const meta = sectionBySlug(section);
const name = lang === 'zh' ? meta.zh : meta.en;
const desc = lang === 'zh' ? meta.zhDesc : meta.enDesc;
const ex = EXPLAINERS[section];
const exText = ex ? ex[lang] : null;

const articles = (await getCollection(
  'articles',
  ({ data }) => data.lang === lang && data.section === section && !data.draft,
)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const banners: Record<string, string> = {
  pqc: '/images/pqc/ml-kem.jpg',
  quantum: '/images/quantum/shor.jpg',
  security: '/images/security/security.jpg',
  migration: '/images/migration/migration.jpg',
  research: '/images/research/research.jpg',
  tutorials: '/images/tutorials/liboqs.jpg',
};
const banner = banners[section];
---

<BaseLayout lang={lang} title={name} description={desc} current={section}>
  <div class="sec-theme" style={ex ? `--sec-accent: ${ex.accent}` : undefined}>
    <section class="hero hero-visual hero-banner">
      {banner && <img class="hero-bg" src={banner} alt="" fetchpriority="high" />}
      <div class="hero-shade"></div>
      <div class="wrap hero-in">
        <p class="kicker">{t.siteName} · {section.toUpperCase()}</p>
        <h1 style="font-size: clamp(1.8rem, 4.4vw, 2.6rem)">{name}</h1>
        <p class="lead">{desc}</p>
      </div>
    </section>

    {ex && exText && (
      <section class="explain wrap reveal">
        <div class="explain-art">
          <ExplainerArt kind={ex.art} />
        </div>
        <div class="explain-text">
          <p class="explain-kicker">{t.explainTitle}</p>
          <p class="explain-essence">{exText.essence}</p>
          <ol class="explain-points">
            {exText.points.map((p) => <li>{p}</li>)}
          </ol>
        </div>
      </section>
    )}

    <section class="block wrap reveal" style="padding-top: 2.6rem">
      <div class="sec-head">
        <span class="sec-no">§</span>
        <h2>{t.sectionArticles}</h2>
        <span class="sec-rule" aria-hidden="true"></span>
      </div>
      {articles.length > 0 ? (
        <div class="grid">
          {articles.map((e) => <ArticleCard lang={lang} entry={e} />)}
        </div>
      ) : (
        <p class="empty-note">{t.emptySection}</p>
      )}
    </section>
  </div>
</BaseLayout>
