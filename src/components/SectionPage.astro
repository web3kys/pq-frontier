---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from './ArticleCard.astro';
import { sectionBySlug, ui, type Lang } from '../lib/i18n';

interface Props { lang: Lang; section: string }
const { lang, section } = Astro.props;
const t = ui[lang];
const meta = sectionBySlug(section);
const name = lang === 'zh' ? meta.zh : meta.en;
const desc = lang === 'zh' ? meta.zhDesc : meta.enDesc;

const articles = (await getCollection(
  'articles',
  ({ data }) => data.lang === lang && data.section === section && !data.draft,
)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout lang={lang} title={name} description={desc} current={section}>
  <section class="hero">
    <div class="wrap hero-in">
      <p class="kicker">{t.siteName} · {section.toUpperCase()}</p>
      <h1 style="font-size: clamp(1.8rem, 4.4vw, 2.6rem)">{name}</h1>
      <p class="lead">{desc}</p>
    </div>
  </section>

  <section class="block wrap">
    {articles.length > 0 ? (
      <div class="grid">
        {articles.map((e) => <ArticleCard lang={lang} entry={e} />)}
      </div>
    ) : (
      <p class="empty-note">{t.emptySection}</p>
    )}
  </section>
</BaseLayout>
