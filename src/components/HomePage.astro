---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from './ArticleCard.astro';
import { SECTIONS, sectionBySlug, ui, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];

const all = (await getCollection('articles', ({ data }) => data.lang === lang && !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = all.filter((e) => e.data.featured);
const featureMain = featured[0];
const featureRest = featured.slice(1, 4);
const latest = all.slice(0, 6);

const fmtDate = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;

const glyphs: Record<string, string> = {
  pqc: '⬡',
  quantum: '◉',
  security: '⛨',
  migration: '⇪',
  research: '✦',
  tutorials: '⌘',
};

const tickerItems =
  lang === 'zh'
    ? ['FIPS 203 · ML-KEM', 'FIPS 204 · ML-DSA', 'FIPS 205 · SLH-DSA', 'Module-LWE', 'Shor 算法', '量子纠错', '先存后破', '混合密钥交换', 'CNSA 2.0', '后量子迁移']
    : ['FIPS 203 · ML-KEM', 'FIPS 204 · ML-DSA', 'FIPS 205 · SLH-DSA', 'Module-LWE', "Shor's Algorithm", 'Quantum Error Correction', 'Harvest Now, Decrypt Later', 'Hybrid Key Exchange', 'CNSA 2.0', 'Post-Quantum Migration'];

const stats =
  lang === 'zh'
    ? [
        { v: '3', l: '部 NIST FIPS 后量子标准' },
        { v: '6', l: '大长期研究方向' },
        { v: '2', l: '种语言 · 中英双语' },
        { v: '100%', l: '原创研究与教程' },
      ]
    : [
        { v: '3', l: 'NIST FIPS PQC standards' },
        { v: '6', l: 'long-term research areas' },
        { v: '2', l: 'languages · zh & en' },
        { v: '100%', l: 'original research & tutorials' },
      ];
---

<BaseLayout lang={lang} title={t.siteName} current="home">
  <section class="hero hero-visual">
    <img class="hero-bg" src="/images/site/hero.jpg" alt="" fetchpriority="high" />
    <canvas id="lattice-canvas" aria-hidden="true"></canvas>
    <div class="hero-shade"></div>
    <div class="wrap hero-in">
      <p class="kicker">PQ Frontier · {lang === 'zh' ? '后量子前沿' : 'Post-Quantum Frontier'}</p>
      <h1>{t.siteName}</h1>
      <p class="tagline">{t.tagline}</p>
      <p class="lead">{t.heroLead}</p>
      <div class="hero-stats">
        {stats.map((s) => (
          <div class="stat">
            <span class="stat-v">{s.v}</span>
            <span class="stat-l">{s.l}</span>
          </div>
        ))}
      </div>
      <div class="hero-meta" aria-hidden="true">
        <span>POST-QUANTUM CRYPTOGRAPHY — QUANTUM COMPUTING — DIGITAL SECURITY</span>
        <span class="hero-meta-r">{t.scrollHint} ↓</span>
      </div>
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {[...tickerItems, ...tickerItems].map((item) => (
        <span class="ticker-item">{item}<i>✦</i></span>
      ))}
    </div>
  </div>

  <section class="manifesto wrap reveal">
    <p class="manifesto-kicker">{t.manifestoKicker} · Manifesto</p>
    <p class="manifesto-text">{t.manifesto}</p>
    <p class="manifesto-sub">{t.manifestoSub}</p>
  </section>

  <section class="block wrap reveal">
    <div class="sec-head">
      <span class="sec-no">01</span>
      <h2>{t.areasTitle}</h2>
      <span class="sec-rule" aria-hidden="true"></span>
    </div>
    <p class="block-lead">{t.areasLead}</p>
    <div class="index-list">
      {SECTIONS.map((s, i) => (
        <a class="index-row" href={`/${lang}/${s.slug}/`}>
          <span class="index-no">{String(i + 1).padStart(2, '0')}</span>
          <span class="index-glyph" aria-hidden="true">{glyphs[s.slug]}</span>
          <span class="index-main">
            <span class="index-title">{lang === 'zh' ? s.zh : s.en}</span>
            <span class="index-desc">{lang === 'zh' ? s.zhDesc : s.enDesc}</span>
          </span>
          <span class="index-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="block wrap reveal">
    <div class="sec-head">
      <span class="sec-no">02</span>
      <h2>{t.featuredTitle}</h2>
      <span class="sec-rule" aria-hidden="true"></span>
    </div>
    {featureMain ? (
      <>
        <a class="feature-card" href={`/${lang}/${featureMain.data.section}/${featureMain.id.split('/').pop()}/`}>
          <span class="feature-tag">{lang === 'zh' ? '精选 · Featured' : 'Featured'}</span>
          {featureMain.data.heroImage && <img src={featureMain.data.heroImage} alt="" loading="lazy" />}
          <span class="feature-body">
            <span class="meta">{lang === 'zh' ? sectionBySlug(featureMain.data.section).zh : sectionBySlug(featureMain.data.section).en}</span>
            <h3>{featureMain.data.title}</h3>
            <p>{featureMain.data.description}</p>
            <span class="meta" style="color: var(--accent)">{t.readMore} →</span>
          </span>
        </a>
        {featureRest.length > 0 && (
          <div class="grid">
            {featureRest.map((e) => <ArticleCard lang={lang} entry={e} />)}
          </div>
        )}
      </>
    ) : (
      <p class="empty-note">{t.emptyFeatured}</p>
    )}
  </section>

  <section class="block wrap reveal">
    <div class="sec-head">
      <span class="sec-no">03</span>
      <h2>{t.latestTitle}</h2>
      <span class="sec-rule" aria-hidden="true"></span>
    </div>
    {latest.length > 0 ? (
      <div class="ed-list">
        {latest.map((e) => (
          <a class="ed-row" href={`/${lang}/${e.data.section}/${e.id.split('/').pop()}/`}>
            <span class="ed-date">{fmtDate(e.data.pubDate)}</span>
            <span class="ed-main">
              <span class="ed-title">{e.data.title}</span>
              <span class="ed-desc">{e.data.description}</span>
            </span>
            <span class="ed-side">
              <span class="ed-sec">{lang === 'zh' ? sectionBySlug(e.data.section).zh : sectionBySlug(e.data.section).en}</span>
              <span class="ed-arrow" aria-hidden="true">→</span>
            </span>
          </a>
        ))}
      </div>
    ) : (
      <p class="empty-note">{t.emptyLatest}</p>
    )}
  </section>

  <script>
    // Animated lattice overlay in the hero: a drifting grid of points with
    // links between neighbours — a nod to lattice-based cryptography.
    // Reduced-motion keeps a very slow drift rather than a hard cut.
    (() => {
      const canvas = document.getElementById('lattice-canvas') as HTMLCanvasElement | null;
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      const c = ctx;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const SPEED = reduced ? 0.15 : 1;
      const GAP = 92;
      let w = 0;
      let h = 0;
      let points: { bx: number; by: number; ph: number; r: number }[] = [];
      let motes: { x: number; y: number; vy: number; r: number; gold: boolean; ph: number }[] = [];
      let pulses: { x: number; y: number; born: number }[] = [];
      let lastPulse = 0;

      function resize() {
        const parent = canvas.parentElement;
        if (!parent) return;
        const rect = parent.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = rect.width;
        h = rect.height;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        canvas.style.width = w + 'px';
        canvas.style.height = h + 'px';
        c.setTransform(dpr, 0, 0, dpr, 0, 0);
        points = [];
        const cols = Math.ceil(w / GAP) + 2;
        const rows = Math.ceil(h / GAP) + 2;
        for (let i = 0; i < cols; i++) {
          for (let j = 0; j < rows; j++) {
            points.push({ bx: i * GAP - GAP / 2, by: j * GAP - GAP / 2, ph: Math.random() * Math.PI * 2, r: 1.1 + Math.random() * 1.3 });
          }
        }
        motes = [];
        const moteCount = Math.min(30, Math.floor((w * h) / 26000));
        for (let i = 0; i < moteCount; i++) {
          motes.push({
            x: Math.random() * w,
            y: Math.random() * h,
            vy: 6 + Math.random() * 10,
            r: 0.8 + Math.random() * 1.6,
            gold: Math.random() < 0.35,
            ph: Math.random() * Math.PI * 2,
          });
        }
      }

      const t0 = performance.now();
      function frame(now: number) {
        const t = ((now - t0) / 1000) * SPEED;
        c.clearRect(0, 0, w, h);
        const pos = points.map((p) => ({
          x: p.bx + Math.sin(t * 0.35 + p.ph) * 9,
          y: p.by + Math.cos(t * 0.28 + p.ph * 1.7) * 9,
          r: p.r,
          ph: p.ph,
        }));
        c.lineWidth = 1;
        for (let i = 0; i < pos.length; i++) {
          for (let j = i + 1; j < pos.length; j++) {
            const dx = pos[i].x - pos[j].x;
            const dy = pos[i].y - pos[j].y;
            const d2 = dx * dx + dy * dy;
            if (d2 < GAP * GAP * 1.45) {
              const a = 0.13 * (1 - d2 / (GAP * GAP * 1.45));
              c.strokeStyle = `rgba(96, 200, 250, ${a.toFixed(3)})`;
              c.beginPath();
              c.moveTo(pos[i].x, pos[i].y);
              c.lineTo(pos[j].x, pos[j].y);
              c.stroke();
            }
          }
        }
        for (const p of pos) {
          const glow = 0.55 + 0.45 * Math.sin(t * 0.9 + p.ph * 3);
          c.fillStyle = `rgba(125, 220, 252, ${(0.35 + 0.4 * glow).toFixed(3)})`;
          c.beginPath();
          c.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          c.fill();
        }
        // travelling pulse rings across the lattice
        if (now - lastPulse > 2600 / SPEED && pos.length > 0) {
          const src = pos[Math.floor(Math.random() * pos.length)];
          pulses.push({ x: src.x, y: src.y, born: now });
          lastPulse = now;
        }
        pulses = pulses.filter((pl) => (now - pl.born) / 1000 < 2.6);
        for (const pl of pulses) {
          const age = (now - pl.born) / 1000;
          const radius = 12 + age * 90 * SPEED;
          const alpha = 0.22 * (1 - age / 2.6);
          c.strokeStyle = `rgba(125, 220, 252, ${alpha.toFixed(3)})`;
          c.lineWidth = 1.4;
          c.beginPath();
          c.arc(pl.x, pl.y, radius, 0, Math.PI * 2);
          c.stroke();
        }
        // rising light motes
        for (const m of motes) {
          m.y -= (m.vy * SPEED) / 60;
          m.x += Math.sin(t * 0.6 + m.ph) * 0.18;
          if (m.y < -6) {
            m.y = h + 6;
            m.x = Math.random() * w;
          }
          const tw = 0.4 + 0.6 * (0.5 + 0.5 * Math.sin(t * 1.4 + m.ph * 2));
          c.fillStyle = m.gold
            ? `rgba(240, 200, 110, ${(0.5 * tw).toFixed(3)})`
            : `rgba(150, 215, 250, ${(0.45 * tw).toFixed(3)})`;
          c.beginPath();
          c.arc(m.x, m.y, m.r, 0, Math.PI * 2);
          c.fill();
        }
        requestAnimationFrame(frame);
      }

      resize();
      window.addEventListener('resize', resize);
      requestAnimationFrame(frame);
    })();
  </script>
</BaseLayout>
