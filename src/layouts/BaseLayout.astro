---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { SECTIONS, ui, counterpartPath, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** nav slug to highlight: a section slug, 'resources', 'about', 'search', or 'home' */
  current?: string;
  /** Existing language versions of this page, as paths. Defaults to the
   *  mirrored path in both languages (true for all static pages). Article
   *  pages pass only the versions that actually exist — never fake a
   *  translation that is not there. */
  alternates?: { zh?: string; en?: string };
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
}

const { lang, title, description, current = '', alternates, ogType = 'website', jsonLd } = Astro.props;
const t = ui[lang];
const pathname = Astro.url.pathname;
const other: Lang = lang === 'zh' ? 'en' : 'zh';
const switchHref = counterpartPath(pathname, other);
const fullTitle = title === t.siteName ? title : `${title} · ${t.siteName}`;
const desc = description ?? t.heroLead;
const htmlLang = lang === 'zh' ? 'zh-CN' : 'en';

const site = Astro.site;
const abs = (p: string) => (site ? new URL(p, site).href : p);
const canonical = abs(pathname);
const altZh = alternates?.zh ?? (lang === 'zh' ? pathname : counterpartPath(pathname, 'zh'));
const altEn = alternates?.en ?? (lang === 'en' ? pathname : counterpartPath(pathname, 'en'));
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        var saved = localStorage.getItem('pq-theme');
        document.documentElement.dataset.theme = saved === 'light' ? 'light' : 'dark';
      } catch (e) {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    {altZh && <link rel="alternate" hreflang="zh-CN" href={abs(altZh)} />}
    {altEn && <link rel="alternate" hreflang="en" href={abs(altEn)} />}
    {(altZh ?? altEn) && <link rel="alternate" hreflang="x-default" href={abs((altZh ?? altEn)!)} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${t.siteName} RSS`}
      href={abs(`/${lang}/rss.xml`)}
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="bg-fx" aria-hidden="true"></div>
    <header class="site-header">
      <div class="wrap header-in">
        <a class="brand" href={`/${lang}/`}>
          <img src="/favicon.svg" alt="" width="30" height="30" />
          <span>
            {t.siteName}
            <span class="brand-sub">{t.siteNameEn}</span>
          </span>
        </a>
        <nav class="main-nav" aria-label="Primary">
          {SECTIONS.map((s) => (
            <a
              href={`/${lang}/${s.slug}/`}
              aria-current={current === s.slug ? 'page' : undefined}
            >
              {lang === 'zh' ? s.zh : s.en}
            </a>
          ))}
          <a href={`/${lang}/resources/`} aria-current={current === 'resources' ? 'page' : undefined}>{t.navResources}</a>
          <a href={`/${lang}/specials/`} aria-current={current === 'specials' ? 'page' : undefined}>{t.navSpecials}</a>
          <a href={`/${lang}/glossary/`} aria-current={current === 'glossary' ? 'page' : undefined}>{t.navGlossary}</a>
          <a href={`/${lang}/about/`} aria-current={current === 'about' ? 'page' : undefined}>{t.navAbout}</a>
          <a href={`/${lang}/search/`} aria-current={current === 'search' ? 'page' : undefined}>{t.navSearch}</a>
        </nav>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark / light theme">◐</button>
        <a class="lang-switch" href={switchHref} aria-label={t.langSwitchLabel} hreflang={other}>
          {t.langSwitch}
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-in">
        <span class="f-brand">{t.siteName} · {t.siteNameEn}</span>
        <span>{t.footerNote}</span>
        <span>© {new Date().getFullYear()} PQ Frontier. {t.footerRights}.</span>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var els = document.querySelectorAll('.reveal');
        if (!('IntersectionObserver' in window) || !els.length) {
          els.forEach(function (el) { el.classList.add('in'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting) {
              en.target.classList.add('in');
              io.unobserve(en.target);
            }
          });
        }, { threshold: 0.08 });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', function () {
          var next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('pq-theme', next); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
