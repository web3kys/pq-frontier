---
// Bilingual 404 — a static host serves this single page for any missing
// path, so it carries both languages and no per-language chrome.
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 · 后量子前沿 Post-Quantum Frontier</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        var saved = localStorage.getItem('pq-theme');
        document.documentElement.dataset.theme = saved === 'light' ? 'light' : 'dark';
      } catch (e) { document.documentElement.dataset.theme = 'dark'; }
    </script>
  </head>
  <body>
    <main class="wrap notfound">
      <p class="code">404</p>
      <h1>页面不存在</h1>
      <p>你要找的页面不在这里，可能已被移动或删除。</p>
      <p><a href="/zh/">返回中文首页</a></p>
      <hr style="border: none; border-top: 1px solid var(--line-soft); margin: 2.2rem auto; max-width: 420px" />
      <h2 style="font-size: 1.2rem">Page not found</h2>
      <p>The page you are looking for is not here — it may have been moved or deleted.</p>
      <p><a href="/en/">Back to the English home page</a></p>
    </main>
  </body>
</html>
