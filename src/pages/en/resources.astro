---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui } from '../../lib/i18n';

const t = ui.en;

const groups = [
  {
    title: 'Official Standards & Institutions',
    items: [
      {
        name: 'NIST Post-Quantum Cryptography Project',
        url: 'https://csrc.nist.gov/projects/post-quantum-cryptography',
        note: 'The official NIST page for PQC standardization: full standard texts, the selection process and implementation guidance.',
      },
      {
        name: 'FIPS 203 · ML-KEM',
        url: 'https://doi.org/10.6028/NIST.FIPS.203',
        note: 'Module-lattice-based key-encapsulation mechanism standard, published August 2024.',
      },
      {
        name: 'FIPS 204 · ML-DSA',
        url: 'https://doi.org/10.6028/NIST.FIPS.204',
        note: 'Module-lattice-based digital signature standard, published August 2024.',
      },
      {
        name: 'FIPS 205 · SLH-DSA',
        url: 'https://doi.org/10.6028/NIST.FIPS.205',
        note: 'Stateless hash-based digital signature standard, published August 2024.',
      },
      {
        name: 'IETF Datatracker',
        url: 'https://datatracker.ietf.org',
        note: 'The Internet Engineering Task Force document library: post-quantum protocol drafts and RFCs from the TLS, LAMPS and other working groups.',
      },
      {
        name: 'ETSI Quantum-Safe Cryptography',
        url: 'https://www.etsi.org/technologies/quantum-safe-cryptography',
        note: 'The European Telecommunications Standards Institute technology page and reports on quantum-safe cryptography.',
      },
    ],
  },
  {
    title: 'Open-Source Implementations',
    items: [
      {
        name: 'Open Quantum Safe (liboqs)',
        url: 'https://openquantumsafe.org',
        note: 'An open-source C library of post-quantum algorithms and protocol integrations, for experimentation and prototyping.',
      },
      {
        name: 'PQClean',
        url: 'https://github.com/PQClean/PQClean',
        note: 'Clean, readable and auditable implementations of post-quantum schemes.',
      },
    ],
  },
];
---

<BaseLayout lang="en" title={t.resourcesTitle} description={t.resourcesLead} current="resources">
  <section class="hero">
    <div class="wrap hero-in">
      <p class="kicker">{t.siteName} · Resources</p>
      <h1 style="font-size: clamp(1.8rem, 4.4vw, 2.6rem)">{t.resourcesTitle}</h1>
      <p class="lead">{t.resourcesLead}</p>
    </div>
  </section>

  {groups.map((g) => (
    <section class="block wrap">
      <h2>{g.title}</h2>
      <div class="grid">
        {g.items.map((item) => (
          <a class="card" href={item.url} target="_blank" rel="noopener noreferrer">
            <h3>{item.name}</h3>
            <p>{item.note}</p>
            <span class="meta" style="margin-top: 0.6rem; color: var(--accent)">{new URL(item.url).hostname} ↗</span>
          </a>
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
